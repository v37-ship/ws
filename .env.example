# Visitor analytics (Umami). Leave empty to disable the tracker.
# Dev: http://localhost:8030 · VPS/prod: https://wangga.biz.id/_u
# (first-party: Traefik maps /_u/* on the main domain to Umami, so ad
# blockers cannot drop the third-party host; script.js + /api/* stay outside
# BasicAuth — the tracker is anonymous and the SPA carries its own Bearer
# token. See docker-compose.vps.yml labels.)
ANALYTICS_URL=
ANALYTICS_SITE_ID=

# Umami dashboard BasicAuth on the VPS (Traefik middleware umami-auth).
# Env-file caveat: double every literal '$' in the bcrypt hash ($$ -> $).
UMAMI_BA_USER=
UMAMI_BA_HASH=

# WhatsApp (Evolution API). WA_ENABLED=false is mock mode: the outbox renders
# and logs messages instead of sending, so dev/CI need no instance. Pair a
# number (QR) before flipping it to true. WA_API_KEY doubles as the Evolution
# AUTHENTICATION_API_KEY.
WA_ENABLED=false
WA_API_URL=http://evolution:8080
WA_API_KEY=dev-wa-key
WA_INSTANCE=wangga
WA_WEBHOOK_SECRET=dev-webhook-secret
WA_REMINDER_HOUR=18
WA_SEND_RATE=1s
# Direct "write a review" link used by the post-visit message (phase 1).
GOOGLE_REVIEW_URL=https://g.page/r/CTLPrFudX25eEBM/review
